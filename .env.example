# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated or newline-separated list of multiple Gemini API keys
# Used for automatic round-robin rotation, load-balancing, and instant quota failover (429 / RESOURCE_EXHAUSTED).
# Example: GEMINI_API_KEYS="key_alpha,key_beta,key_gamma"
GEMINI_API_KEYS=

# Numbered keys are also automatically detected and pooled (e.g. GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BYTEZ_API_KEY: Optional secondary AI inference provider key (e.g. Bytez API).
# Used as multi-provider fallback or alternative model routing.
BYTEZ_API_KEY=

