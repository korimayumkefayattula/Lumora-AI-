{
  "entities": {
    "StudentProject": {
      "title": "StudentProject",
      "description": "Student web builder project code and workspace state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "html": { "type": "string" },
        "css": { "type": "string" },
        "js": { "type": "string" },
        "version": { "type": "number" },
        "studentHandle": { "type": "string" },
        "studentEmail": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "html", "updatedAt"]
    },
    "PublishedSite": {
      "title": "PublishedSite",
      "description": "Published student websites for Firebase Hosting integration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "html": { "type": "string" },
        "css": { "type": "string" },
        "js": { "type": "string" },
        "publishedUrl": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentName": { "type": "string" },
        "publishedAt": { "type": "string" },
        "views": { "type": "number" }
      },
      "required": ["id", "title", "publishedUrl", "publishedAt"]
    },
    "SharedWorkspaceRoom": {
      "title": "SharedWorkspaceRoom",
      "description": "Multiplayer real-time co-editing room for student projects",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "projectId": { "type": "string" },
        "activeTab": { "type": "string" },
        "html": { "type": "string" },
        "css": { "type": "string" },
        "js": { "type": "string" },
        "lastEditedBy": { "type": "string" },
        "lastEditedAt": { "type": "string" },
        "collaborators": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["roomId", "projectId", "lastEditedAt"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "Student quick study notes synced with Google Keep format",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "pinned": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "userId", "updatedAt"]
    },
    "AcademicEvent": {
      "title": "AcademicEvent",
      "description": "Student calendar events synced with Google Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "googleEventId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "userId"]
    }
  },
  "firestore": {
    "/student_projects/{projectId}": {
      "schema": "StudentProject",
      "description": "Stores user web builder projects and 30-second auto-save state."
    },
    "/published_sites/{siteId}": {
      "schema": "PublishedSite",
      "description": "Stores published sites with live preview links."
    },
    "/shared_workspaces/{roomId}": {
      "schema": "SharedWorkspaceRoom",
      "description": "Real-time collaborative workspace state for co-editing."
    },
    "/keep_notes/{noteId}": {
      "schema": "KeepNote",
      "description": "Quick study notes and checklists matching Google Keep style."
    },
    "/calendar_events/{eventId}": {
      "schema": "AcademicEvent",
      "description": "Academic study schedule and exam calendar events."
    }
  }
}
